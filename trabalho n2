#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define PRODUTOS 200
#define CLIENTES 50

int random(int n)
{
    return rand() % n;
}

int main() {
    int i, numProdutos, numClientes;
    int compra[CLIENTES];
    float preco[PRODUTOS];
    float total = 0;

    // Semente para gerar números diferentes
    srand(time(NULL));

    // Definir número de produtos (1 a 200)
    numProdutos = rand() % PRODUTOS + 1;

    // Preencher preços dos produtos (R$5 a R$100)
    for (i = 0; i < numProdutos; i++) {
        preco[i] = 5 + rand() % 96;
    }

    // Definir número de clientes (1 a 50)
    numClientes = rand() % CLIENTES + 1;

    // Cada cliente compra um produto aleatório
    for (i = 0; i < numClientes; i++) {
        compra[i] = rand() % numProdutos;
        total += preco[compra[i]];
    }

    // Exibir os produtos
    printf("========================================\n");
    printf("         SIMULACAO DE VENDAS            \n");
    printf("========================================\n\n");

    printf("Numero de produtos: %d\n", numProdutos);
    printf("----------------------------------------\n");
    printf("| Codigo |   Preco (R$)  |\n");
    printf("----------------------------------------\n");
    for (i = 0; i < numProdutos; i++) {
        printf("|  %4d  |     %6.2f   |\n", i, preco[i]);
    }
    printf("----------------------------------------\n\n");

    // Exibir as compras dos clientes
    printf("Numero de clientes: %d\n", numClientes);
    printf("----------------------------------------\n");
    printf("| Cliente | Produto |   Valor (R$) |\n");
    printf("----------------------------------------\n");
    for (i = 0; i < numClientes; i++) {
        printf("|   %3d   |   %4d  |    %6.2f   |\n", i, compra[i], preco[compra[i]]);
    }
    printf("----------------------------------------\n");

    // Total arrecadado
    printf("\nTOTAL ARRECADADO NO DIA: R$ %.2f\n", total);
    printf("========================================\n");

    return 0;
}
